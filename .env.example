# Supabase: server only. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Faz 5: Google Sheets API. Service account JSON stays on the server only.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Yoklama
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Web Push. Generate once with web-push; keep the private key on the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Protect /api/cron/deliveries. Vercel sends this as a Bearer token.
CRON_SECRET=
